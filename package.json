{
  "name": "rtl-bidi-plugin",
  "version": "0.4.0",
  "private": true,
  "description": "Bilingual Arabic/English bidi fix for the DeepSeek Harness Web client: per-block base direction, isolated code blocks, auto-direction composer.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/client.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "id": "rtl-bidi-plugin",
      "version": "0.4.0",
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "rtl",
    "bidi",
    "arabic",
    "english",
    "unicode-bidi",
    "text-direction"
  ],
  "author": "Hany Hassan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hany-php/dsh-rtl-bidi-plugin.git"
  },
  "homepage": "https://github.com/hany-php/dsh-rtl-bidi-plugin#readme",
  "bugs": {
    "url": "https://github.com/hany-php/dsh-rtl-bidi-plugin/issues"
  }
}
